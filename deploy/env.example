NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
DATABASE_URL=postgres:///postgres?host=/var/run/postgresql
SANDBOX_TEMPLATE_DB=ow_template
SANDBOX_PUBLIC_DB=ow_public
SANDBOX_UPLOAD_ROOT=/var/lib/ow-scrims/sandboxes
SANDBOX_IDLE_MINUTES=120
SANDBOX_MAX=20
# This count includes the snapshot's own maps, so the per-visitor allowance is this limit minus the template's map count.
SANDBOX_MAX_MAPS=40
SANDBOX_CREATES_PER_MINUTE=10
# A 50 MB log peaks near 600 MB of heap while parsing, which is the unit's whole MemoryMax.
MAX_UPLOAD_MB=8
LOG_DIR=/var/lib/ow-scrims/logs
MAP_IMAGE_DIR=/var/lib/ow-scrims/map-images
